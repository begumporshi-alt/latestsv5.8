# Connection settings for the NEW Supabase project.
#
# Fill these in once the project exists:
#   Project Settings -> API        -> URL, anon key, service_role key
#   Project Settings -> Database   -> Connection string -> Session pooler (5432)
#
# Note there is no NEXT_PUBLIC_ prefix on the service role key. Anything with
# that prefix is inlined into the browser bundle at build time, which would
# publish a key that bypasses every RLS policy. lib/admin-auth.ts already reads
# SUPABASE_SERVICE_ROLE_KEY first, so the server-side path works unchanged.

NEXT_PUBLIC_SUPABASE_URL=https://<new-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_DB_URL=postgresql://postgres.<new-project-ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
